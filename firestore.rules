rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsProfile(userId) { return signedIn() && request.auth.uid == userId; }
    function isTournamentMember(data) { return signedIn() && request.auth.uid in data.memberIds; }
    function canReadTournament(data) { return data.visibility == 'public' || isTournamentMember(data); }
    function isValidJoin(tournamentId) {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.lastJoinCode is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.lastJoinCode)).data.tournamentId == tournamentId;
    }

    match /users/{userId} {
      allow create: if ownsProfile(userId);
      allow read, update, delete: if ownsProfile(userId);
    }

    match /tournaments/{tournamentId} {
      allow create: if signedIn() && request.resource.data.organizerId == request.auth.uid && request.auth.uid in request.resource.data.memberIds;
      allow get, list: if canReadTournament(resource.data);
      allow update: if (isTournamentMember(resource.data) && request.auth.uid == resource.data.organizerId) || isValidJoin(tournamentId);
      allow delete: if isTournamentMember(resource.data) && request.auth.uid == resource.data.organizerId;

      match /{subcollection}/{documentId} {
        allow read: if canReadTournament(get(/databases/$(database)/documents/tournaments/$(tournamentId)).data);
        allow write: if isTournamentMember(get(/databases/$(database)/documents/tournaments/$(tournamentId)).data);
      }
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.organizerId == request.auth.uid
        && get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.organizerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
